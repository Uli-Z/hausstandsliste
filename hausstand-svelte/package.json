{
  "name": "hausstand-svelte-singlefile",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.ui-v3.config.js --host 127.0.0.1",
    "build": "vite build --config vite.ui-v3.config.js",
    "build:single": "npm run build && node scripts/inline-ui-v3.mjs --standalone",
    "build:php": "node scripts/build-php.mjs",
    "check:js": "node --check scripts/inline-ui-v3.mjs && node --check scripts/build-php.mjs && node --check tests/browser-qa.mjs && node --check tests/invalid-input-qa.mjs && node --check tests/time-travel-forms-qa.mjs && node --check bin/hausstand.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-qa.mjs"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "latest",
    "vite": "latest",
    "svelte": "latest"
  },
  "devDependencies": {}
}
